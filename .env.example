# Development defaults. Do not place secrets in this file.
PORT=4173
APP_ENV=development
PERSISTENCE_ADAPTER=json
DATABASE_URL=<SET_IN_APPROVED_SECRET_STORE>
AUTH_ADAPTER=dev
DEV_ADMIN_KEY=development-only-admin

# Approved OIDC provider values. Required when AUTH_ADAPTER=authjs.
AUTH_SECRET=
AUTH_URL=http://127.0.0.1:4173
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_PROVIDER_NAME=
OIDC_AUTHORIZATION_URL=
OIDC_TOKEN_URL=
OIDC_USERINFO_URL=

# Production providers remain disabled until approved and configured.
PAYMENT_PROVIDER=development
BOOKING_PROVIDER=development
MODEL_PROVIDER=development
ANALYTICS_PROVIDER=disabled
