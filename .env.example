# Variable names only. Store every secret in an approved secret manager,
# including development values. Never copy production secrets into development
# or preview.

# Server configuration
PORT=
APP_ENV=
PERSISTENCE_ADAPTER=
AUTH_ADAPTER=
PAYMENT_PROVIDER=
BOOKING_PROVIDER=
MODEL_PROVIDER=
ANALYTICS_PROVIDER=

# Server-only runtime secrets
DATABASE_URL=
AUTH_SECRET=
OIDC_CLIENT_SECRET=
DEV_ADMIN_KEY=

# Server-only runtime configuration
AUTH_URL=
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_PROVIDER_NAME=
OIDC_AUTHORIZATION_URL=
OIDC_TOKEN_URL=
OIDC_USERINFO_URL=

# Migration-only secret. Do not add this to Vercel runtime.
DIRECT_URL=

# CI/CD secret and protected configuration
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=

# Optional future provider secrets. Not required until an approved adapter uses
# the corresponding provider. Treat them as production secrets in every
# environment and never expose them to browser code.
CLAUDE_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
